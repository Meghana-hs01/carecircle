# CareCircle Environment Configuration Example

# Environment Mode: development / production / staging
ENVIRONMENT=development
DEBUG=true

# Security
# Generate using: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=carecircle-super-secret-jwt-key-2026-production-grade-change-in-env
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database
# Local SQLite fallback: sqlite:///./carecircle.db
# Production PostgreSQL: postgresql://username:password@hostname:5432/carecircle
DATABASE_URL=sqlite:///./carecircle.db

# Cloud Scheduler & Cron Authorization Token
CRON_SECRET=carecircle-internal-job-token-2026

# Real SMTP Email Delivery (Optional)
# If left blank, notifications accurately report DeliveryStatus as SKIPPED_NO_CREDENTIALS
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=notifications@carecircle.health
SMTP_FROM_NAME=CareCircle Health Alerts

# Frontend URL for CORS
FRONTEND_URL=http://localhost:5173
